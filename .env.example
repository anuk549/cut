# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Session / encryption secrets (required in production, min 32 chars)
ADMIN_SESSION_SECRET=replace-with-32-plus-char-random-secret
USER_SESSION_SECRET=replace-with-32-plus-char-random-secret
ENCRYPTION_KEY=replace-with-64-char-random-encryption-key

# Admin password hash (scrypt:salt:hash) - optional fallback
ADMIN_PASSWORD_HASH=

# Admin WhatsApp number (E.164)
ADMIN_WHATSAPP=94703799364
